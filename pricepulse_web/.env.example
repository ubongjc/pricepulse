# Database
DATABASE_URL="postgresql://user:password@localhost:5432/pricepulse?schema=public"

# Clerk Authentication (https://clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxx
CLERK_SECRET_KEY=sk_test_xxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Stripe (https://stripe.com)
STRIPE_SECRET_KEY=sk_test_xxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET_NAME=pricepulse-receipts
R2_PUBLIC_URL=https://your-bucket.r2.dev

# Sentry (https://sentry.io)
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
SENTRY_ORG=your_org
SENTRY_PROJECT=pricepulse-web
SENTRY_AUTH_TOKEN=your_auth_token

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# OpenTelemetry (Optional)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=pricepulse-web

# Feature Flags (Optional)
ENABLE_OCR=true
ENABLE_BENCHMARKS=true
ENABLE_PREMIUM_FEATURES=true

# Redis (for rate limiting & background jobs) - https://upstash.com/
REDIS_URL=your_redis_url
REDIS_TOKEN=your_redis_token

# Instacart API (for price data) - https://www.instacart.com/partner
INSTACART_API_KEY=your_api_key
INSTACART_CLIENT_ID=your_client_id
INSTACART_SECRET=your_secret

# Price Data APIs
UPC_DATABASE_API_KEY=your_upc_api_key
BARCODE_LOOKUP_API_KEY=your_barcode_api_key

# Push Notifications - Firebase Cloud Messaging
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_PRIVATE_KEY=your_private_key
FIREBASE_CLIENT_EMAIL=your_client_email
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_vapid_key

# Email Notifications - Resend (https://resend.com)
RESEND_API_KEY=your_resend_api_key
FROM_EMAIL=noreply@pricepulse.app

# SMS Notifications - Twilio (https://www.twilio.com)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Analytics (privacy-friendly) - Plausible (https://plausible.io)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=pricepulse.app

# Maps & Location - Mapbox (https://www.mapbox.com)
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token

# Cron Jobs
ENABLE_PRICE_UPDATES=true
PRICE_UPDATE_SCHEDULE="0 0,12 * * *"
