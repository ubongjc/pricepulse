// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

enum UserRole {
  USER
  PREMIUM
  ADMIN
}

enum DataSharingPreference {
  NONE
  ANONYMOUS
  FULL
}

model User {
  id                     String                  @id @default(cuid())
  clerkId                String                  @unique
  email                  String                  @unique
  firstName              String?
  lastName               String?
  role                   UserRole                @default(USER)
  dataSharingPreference  DataSharingPreference   @default(ANONYMOUS)
  stripeCustomerId       String?                 @unique
  subscriptionStatus     String?
  subscriptionEndDate    DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  receipts               Receipt[]
  dataExportRequests     DataExportRequest[]

  @@index([clerkId])
  @@index([email])
}

model Receipt {
  id                String      @id @default(cuid())
  userId            String
  storeName         String
  storeLocation     String?
  postalCode        String?
  transactionDate   DateTime
  totalAmount       Decimal     @db.Decimal(10, 2)
  taxAmount         Decimal?    @db.Decimal(10, 2)
  receiptImageUrl   String?     // Encrypted blob URL in R2
  receiptImageKey   String?     // Encryption key (stored encrypted by user's key)
  ocrProcessed      Boolean     @default(false)
  ocrProcessedAt    DateTime?
  metadata          Json?       // Additional metadata
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lineItems         LineItem[]

  @@index([userId])
  @@index([transactionDate])
  @@index([postalCode])
  @@index([ocrProcessed])
}

model LineItem {
  id                String      @id @default(cuid())
  receiptId         String
  productName       String
  upc               String?
  quantity          Decimal     @db.Decimal(10, 3)
  unitSize          String?     // e.g., "500ml", "1kg"
  unitSizeNormalized Decimal?   @db.Decimal(10, 3) // Normalized to base unit for comparison
  unitType          String?     // e.g., "ml", "g", "unit"
  unitPrice         Decimal     @db.Decimal(10, 2)
  totalPrice        Decimal     @db.Decimal(10, 2)
  category          String?
  brand             String?
  metadata          Json?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  receipt           Receipt     @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
  @@index([upc])
  @@index([productName])
}

model Benchmark {
  id                String      @id @default(cuid())
  postalCode        String
  upc               String?
  productName       String?
  category          String?
  medianPrice       Decimal     @db.Decimal(10, 2)
  averagePrice      Decimal     @db.Decimal(10, 2)
  minPrice          Decimal     @db.Decimal(10, 2)
  maxPrice          Decimal     @db.Decimal(10, 2)
  sampleCount       Int
  unitSize          String?
  unitSizeNormalized Decimal?   @db.Decimal(10, 3)
  unitType          String?
  lastUpdated       DateTime    @default(now())
  monthYear         String      // Format: "2024-01" for aggregation
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@unique([postalCode, upc, monthYear])
  @@index([postalCode])
  @@index([upc])
  @@index([category])
  @@index([monthYear])
}

model DataExportRequest {
  id                String      @id @default(cuid())
  userId            String
  status            String      @default("pending") // pending, processing, completed, failed
  exportUrl         String?     // Pre-signed URL to download
  expiresAt         DateTime?
  requestedAt       DateTime    @default(now())
  completedAt       DateTime?

  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

// For tracking feature access and billing entitlements
model Entitlement {
  id                String      @id @default(cuid())
  userId            String
  feature           String      // e.g., "premium_analytics", "unlimited_receipts"
  granted           Boolean     @default(true)
  expiresAt         DateTime?
  metadata          Json?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@unique([userId, feature])
  @@index([userId])
  @@index([feature])
}
